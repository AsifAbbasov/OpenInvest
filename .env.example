# Development only. Never use these values outside a local workstation.
POSTGRES_DB=openinvest
POSTGRES_USER=openinvest
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local development auth bypass for pre-auth smoke/dev flows.
# Production must set OPENINVEST_ACCESS_TOKEN_SECRET instead and keep this disabled.
OPENINVEST_DEV_AUTH_BYPASS=true
OPENINVEST_REFRESH_COOKIE_INSECURE=true

# Production/staging: set a high-entropy secret with at least 32 bytes.
OPENINVEST_ACCESS_TOKEN_SECRET=replace-with-32-plus-byte-secret
