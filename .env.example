# Development only. Never use these values outside a local workstation.
POSTGRES_DB=openinvest
POSTGRES_USER=openinvest
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local development may use the schema-owner connection for migration convenience.
# Staging/production DATABASE_URL must authenticate as a dedicated LOGIN role that inherits
# openinvest_runtime after infrastructure/postgres/runtime/openinvest_runtime_role.sql is applied.
# Never use the migration/schema-owner connection as the staging/production API DATABASE_URL.
DATABASE_URL=postgres://openinvest:replace-with-a-local-password@127.0.0.1:5432/openinvest?sslmode=disable

# Local development auth bypass for pre-auth smoke/dev flows.
# Unsafe local auth flags require OPENINVEST_ENV=development or local when DATABASE_URL is set.
# Production must set OPENINVEST_ACCESS_TOKEN_SECRET instead and keep these disabled.
OPENINVEST_ENV=development
OPENINVEST_DEV_AUTH_BYPASS=true
OPENINVEST_REFRESH_COOKIE_INSECURE=true

# API listener ownership. Development/local defaults to 127.0.0.1:8080 when this is empty.
# Staging/production must set an explicit host:port. 0.0.0.0 or [::] is allowed only as an
# explicit operator decision for a container/platform that owns the network boundary.
OPENINVEST_API_LISTEN_ADDRESS=

# Deployment-global abuse-control ownership. Development/local may leave this empty.
# Staging/production must be fronted by a verified shared edge/gateway that enforces the
# deployment-level abuse budgets documented in docs/operations/ABUSE_PROTECTION_DEPLOYMENT.md.
OPENINVEST_DEPLOYMENT_GLOBAL_ABUSE_CONTROL=

# Shared Redis security-budget authority. Required when the real T-Invest provider is enabled
# outside explicit development/local mode. Use a deployment-private Redis endpoint; credentials
# belong in the runtime secret store, never in frontend/build-time variables.
OPENINVEST_SHARED_BUDGET_REDIS_URL=

# Production/staging: set high-entropy secrets with at least 32 bytes.
OPENINVEST_ACCESS_TOKEN_SECRET=replace-with-32-plus-byte-secret
OPENINVEST_IMPORT_REVIEW_TOKEN_SECRET=replace-with-a-different-32-plus-byte-secret

# T-Invest Corporate Actions is fail-closed and disabled unless BOTH values are configured.
# Use a read-only token only. Keep distinct token values in development and production secret stores.
# Never commit, log, trace, expose to frontend/mobile, or reuse a trading-capable token here.
OPENINVEST_TINVEST_CORPORATE_ACTIONS_ENABLED=false
OPENINVEST_TINVEST_READONLY_TOKEN=
# Required only when T-Invest Corporate Actions is explicitly enabled outside tests/local experimentation.
# It records that a shared deployment/provider control owns the provider-wide budget across replicas.
OPENINVEST_TINVEST_GLOBAL_BUDGET_OWNER=

# HTTP client IP trust model. Direct/local mode is the safe default and ignores forwarding headers.
OPENINVEST_TRUST_PROXY=false
OPENINVEST_TRUSTED_PROXY_CIDRS=
# Production/staging behind a reverse proxy must explicitly set OPENINVEST_TRUST_PROXY=true and
# provide only operator-verified proxy IP addresses/CIDR ranges above. Trust-all ranges are rejected.
# Do not assume all private/loopback/link-local networks are trusted proxies.
